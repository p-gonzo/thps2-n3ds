; PS1 untextured primitives into the GPU copy of VRAM.
; v0 = (x, y) in VRAM pixels (draw offset applied, sampling bias added on the
; CPU); v1 = (r, g, b, a) as bytes 0..255; a carries the PS1 mask bit.
; PICA rules: projection[4] first, every output component written, uniforms
; only as the first operand of dp4/mul.

.fvec projection[4]
.constf k(0.5, 1.0, 0.00392156862745098, 0.0)

.out outpos position
.out outclr color

.alias inpos v0
.alias inclr v1

.proc main
    mov r0.xy, inpos.xy
    mov r0.z, k.x
    mov r0.w, k.y
    dp4 outpos.x, projection[0], r0
    dp4 outpos.y, projection[1], r0
    dp4 outpos.z, projection[2], r0
    dp4 outpos.w, projection[3], r0
    mul outclr, k.zzzz, inclr
    end
.end
